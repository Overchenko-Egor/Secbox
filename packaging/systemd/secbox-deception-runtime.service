[Unit]
Description=SecBox Deception quarantine runtime
Requires=secbox-deception-net.service
Requires=secbox-deception-topology.service
Requires=secbox-firewall.service

After=secbox-deception-net.service
After=secbox-deception-topology.service
After=secbox-firewall.service

Before=secbox-deception-honeypot.service

PartOf=secbox-deception-net.service
PartOf=secbox-firewall.service

[Service]
Type=oneshot
RemainAfterExit=yes

User=root
Group=root
WorkingDirectory=/home/egor/dev/secbox

Environment=PYTHONPATH=/home/egor/dev/secbox/src
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

ExecStart=/home/egor/dev/secbox/.venv/bin/python -m secbox.modules.deception.runtime

NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_DAC_READ_SEARCH

RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

[Unit]
Description=SecBox IDS Event Processor

BindsTo=suricata.service
After=suricata.service network-online.target
Wants=network-online.target

[Service]
Type=simple

WorkingDirectory=/opt/secbox

Environment=SECBOX_CONFIG_PATH=/etc/secbox/config.yml
Environment=PYTHONUNBUFFERED=1

ExecStart=/usr/bin/secboxctl ids run

Restart=on-failure
RestartSec=3s

TimeoutStopSec=15s
KillSignal=SIGTERM

NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

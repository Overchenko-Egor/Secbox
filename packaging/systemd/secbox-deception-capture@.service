[Unit]
Description=SecBox Deception packet capture for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=secbox-deception
Group=secbox-deception

WorkingDirectory=/opt/secbox

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

ExecStart=/opt/secbox/venv/bin/python -m secbox.modules.deception.capture --case-id %i

Restart=no
TimeoutStopSec=10s
KillSignal=SIGTERM

NoNewPrivileges=yes

CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW

ProtectSystem=strict
ProtectHome=yes

ReadOnlyPaths=/var/lib/secbox/deception/cases
ReadWritePaths=/var/lib/secbox/deception/cases/%i/capture

PrivateTmp=yes
PrivateDevices=yes

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

RestrictAddressFamilies=AF_PACKET AF_UNIX AF_INET AF_INET6

RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

SystemCallArchitectures=native

UMask=0077

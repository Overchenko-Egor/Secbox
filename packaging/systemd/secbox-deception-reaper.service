[Unit]
Description=SecBox Deception expired quarantine cleanup
Requires=secbox-deception-net.service
After=secbox-deception-net.service secbox-deception-runtime.service

[Service]
Type=oneshot
User=root
Group=root

WorkingDirectory=/opt/secbox

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

ExecStart=/opt/secbox/venv/bin/python -m secbox.modules.deception.reaper

NoNewPrivileges=yes

CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_DAC_READ_SEARCH

ProtectSystem=strict
ProtectHome=read-only

ReadWritePaths=/var/lib/secbox

RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

UMask=0077

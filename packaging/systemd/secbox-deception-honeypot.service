[Unit]
Description=SecBox Deception Honeypot
Requires=secbox-deception-net.service
Requires=secbox-deception-runtime.service
After=secbox-deception-net.service
After=secbox-deception-runtime.service
PartOf=secbox-deception-net.service

[Service]
Type=simple

User=secbox-deception
Group=secbox-deception

WorkingDirectory=/opt/secbox

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

NetworkNamespacePath=/run/netns/secbox-deception

ExecStart=/opt/secbox/venv/bin/python -m secbox.modules.deception.honeypot

Restart=on-failure
RestartSec=3s

NoNewPrivileges=yes

CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

ProtectSystem=strict
ProtectHome=read-only

ReadOnlyPaths=/var/lib/secbox/deception/cases
ReadOnlyPaths=/var/lib/secbox/deception/tls
ReadWritePaths=/var/lib/secbox/deception/honeypot

PrivateTmp=yes
PrivateDevices=yes

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

RestrictAddressFamilies=AF_UNIX AF_INET

RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

SystemCallArchitectures=native

UMask=0077

[Install]
WantedBy=multi-user.target

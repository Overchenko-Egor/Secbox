[Unit]
Description=SecBox VPN Failover Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

WorkingDirectory=/home/egor/dev/secbox

Environment=SECBOX_CONFIG_PATH=/etc/secbox/config.yml
Environment=PYTHONUNBUFFERED=1

ExecStartPre=/home/egor/dev/secbox/.venv/bin/secboxctl vpn apply
ExecStart=/home/egor/dev/secbox/.venv/bin/secboxctl vpn run --interval 3

Restart=on-failure
RestartSec=3s

TimeoutStopSec=15s
KillSignal=SIGTERM

NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

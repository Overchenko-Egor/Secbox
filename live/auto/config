#!/bin/sh
set -eu

lb config noauto \
    --mode debian \
    --distribution bookworm \
    --architectures amd64 \
    --binary-images iso-hybrid \
    --archive-areas "main contrib non-free-firmware" \
    --debian-installer none \
    --apt-recommends true \
    --memtest none \
    --bootappend-live "boot=live components hostname=secbox username=secbox"
